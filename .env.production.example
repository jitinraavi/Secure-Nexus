# Owner-provided production configuration. Never commit a populated copy.
# Compose reads root .env. Native node commands read exported variables,
# node --env-file=.env, or server/.env (loaded by the application).
NODE_ENV=production
PORT=4000
BIND_HOST=0.0.0.0
GROUNDWORK_DATA_DIR=/data
DATABASE_PROVIDER=supabase
# Server-only dedicated runtime-role URI. Never use a VITE_ prefix.
DATABASE_URL=
DATABASE_POOL_MAX=5
# Optional Supabase CA certificate path; certificate verification stays enabled.
DATABASE_SSL_CA_FILE=
# Supply DATABASE_ADMIN_URL only to one-off migration/import commands, not the web service.
GROUNDWORK_SERVER_ROLE=authority
GROUNDWORK_AUTHORITY_GATEWAY_MODE=direct

# Required stable, random base64-encoded 32-byte encryption key.
MASTER_KEY=
PREVIOUS_MASTER_KEY=
# Required public HTTPS origin without path/query.
PUBLIC_APP_ORIGIN=
# Exact IPs of your actual immediate reverse proxies, comma separated.
# Leave empty for no trusted forwarding. Never use wildcard proxy trust.
GROUNDWORK_TRUSTED_PROXY_IPS=
GROUNDWORK_PUBLISH_HOST=127.0.0.1

# Required real email delivery: smtp or resend. No production console fallback.
# Gmail: use smtp.gmail.com, port 465, MAIL_SECURE=true, and a Google app password.
# Local private setup: npm run mail:setup. See docs/GMAIL-OTP.md.
MAIL_PROVIDER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# For Resend select MAIL_PROVIDER=resend and set a verified sender plus this key.
RESEND_API_KEY=

# Live is mandatory in production. Unconfigured checkout stays unavailable.
PAYMENTS_MODE=live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_MODE=live
# Optional prepaid tenant seats: explicit integer paise per seat and term days.
ORGANIZATION_SEAT_PRICE_INR_MINOR=
ORGANIZATION_SEAT_TERM_DAYS=
ADMIN_EMAILS=

# Optional server-side assistant.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
# Live image rendering uses Gemini/Imagen credentials, not AI_API_KEY.
GEMINI_API_KEY=
IMAGEN_API_KEY=
IMAGEN_MODEL=
RENDER_JOB_MAX_ACTIVE=2

# Native deployment is not acceptance-tested; keep disabled.
NATIVE_WORKER_ENABLED=false
NATIVE_ISOLATION_ACKNOWLEDGED=false
