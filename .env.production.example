# ================================================
# Groundwork Production Environment Configuration
# ================================================

# Runtime & Server
NODE_ENV=production
PORT=4000
GROUNDWORK_DATA_DIR=/data

# Cryptographic Master Key (REQUIRED: 32-byte base64 string, e.g. generated via `openssl rand -base64 32`)
MASTER_KEY=

# Optional Master Key Rotation Support (for decrypting projects encrypted under previous release key)
PREVIOUS_MASTER_KEY=

# Outbound Email Configuration (options: smtp, resend, console)
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=apikey
MAIL_PASS=iope fsjn vxuz loyx
MAIL_FROM=Groundwork<groundwork.login@gmail.com>

# Or Resend API:
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_...

# Payments & Subscriptions (options: demo, razorpay)
PAYMENTS_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Enterprise & Tenancy
ORGANIZATION_MAX_SEATS=100

# Native DWG / OpenSees Worker (Only when running sandboxed Linux worker)
NATIVE_WORKER_ENABLED=false
NATIVE_ISOLATION_ACKNOWLEDGED=false
NATIVE_PRLIMIT_PATH=/usr/bin/prlimit
NATIVE_DWG2DXF_PATH=/usr/bin/dwg2dxf
NATIVE_DXF2DWG_PATH=/usr/bin/dxf2dwg
NATIVE_OPENSEES_PATH=/usr/bin/OpenSees
NATIVE_SANDBOX_UID=10001
NATIVE_SANDBOX_GID=10001

# AI Photorealistic Rendering Engine (OpenAI / Open-source compatible)
AI_API_KEY=
AI_MODEL=gpt-4o
AI_BASE_URL=https://api.openai.com/v1
RENDER_JOB_MAX_ACTIVE=2
