{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/deploy-after-ci.mjs --build-guard && npm run build",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "crons": [
    {
      "path": "/api/ops/check",
      "schedule": "0 8 * * *"
    }
  ],
  "installCommand": "npm ci --include=dev",
  "outputDirectory": "client/dist",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "server/{dist,certs}/**"
    },
    "api/collaboration.mjs": {
      "maxDuration": 300,
      "supportsCancellation": true,
      "includeFiles": "server/{dist,certs}/**"
    }
  },
  "routes": [
    {
      "src": "^/(.*)$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests",
        "Permissions-Policy": "camera=(self), microphone=(), geolocation=(self), usb=(), browsing-topics=()"
      },
      "continue": true
    },
    {
      "src": "^/api(?:/.*)?$",
      "headers": {
        "Cache-Control": "private, no-store"
      },
      "continue": true
    },
    {
      "src": "^/sw\\.js$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/offline-shell\\.json$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/api(?:/v1)?/collaboration/[^/]+/events$",
      "dest": "/api/collaboration"
    },
    {
      "src": "^/api(?:/.*)?$",
      "dest": "/api/index"
    },
    {
      "src": "^/$",
      "dest": "/studio.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?:assets|studio-assets)/.*$",
      "status": 404
    },
    {
      "src": "^/.*$",
      "dest": "/index.html"
    }
  ]
}
