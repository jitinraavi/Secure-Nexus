{
  "name": "@groundwork/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/api.test.ts test/offline.test.ts test/render.test.ts test/auth-security.test.ts test/resource-security.test.ts test/upload-design-security.test.ts test/backupAndMail.test.ts test/integration-admin-security.test.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "start:secondary": "node dist/secondaryHost.js",
    "dev:secondary": "node --import tsx src/secondaryHost.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
