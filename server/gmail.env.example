# Example only. Prefer `npm run mail:setup` for hidden password entry and verification.
# Merge these mail settings into server/.env; preserve the existing MASTER_KEY.
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your-google-sender@gmail.com
MAIL_PASS=your_16_character_google_app_password
MAIL_FROM="Groundwork <your-google-sender@gmail.com>"
