# Dependency directories
node_modules/

# Production build outputs
dist/
client/dist/

# Persistent data directories & databases
server/data/
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
backups/

# Supabase CLI local cache
server/supabase/.temp/

# Vercel local project link and pulled environment files
.vercel/

# Environment and secrets (NEVER commit credentials)
.env
.env.*
!.env.example
!.env.production.example
server/.env
server/.env.*
!server/*.env.example
client/.env
client/.env.*
!client/*.env.example

