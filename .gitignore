*.pem
*.key
*.cert
*.crt
!server/certs/supabase-root-2021.crt
*.pfx
*.p12

# Logs and runtime artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.serverless/
artifacts/

# OS metadata
.DS_Store
Thumbs.db
